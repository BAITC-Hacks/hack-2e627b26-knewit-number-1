EKT_API_BASE_URL=https://ekt.kz/api
EKT_API_USERNAME=apiuser
EKT_API_PASSWORD=your_api_password_here

# Switches the implementation behind the same /api/products routes.
CATALOG_PROVIDER=fixture

# Live allowlist: leave empty until the EKT owner approves selling warehouses.
SELLABLE_STORE_IDS=
AVAILABILITY_RULE_VERSION=ekt-allowlist-unapproved-v1
AVAILABILITY_STALE_AFTER_SECONDS=300

# Synthetic fixture-only allowlist.
FIXTURE_SELLABLE_STORE_IDS=1,2,3
FIXTURE_AVAILABILITY_RULE_VERSION=fixture-allowlist-v1
FIXTURE_TIMEOUT_SECONDS=3.1
EKT_CONNECT_TIMEOUT_SECONDS=1
EKT_READ_TIMEOUT_SECONDS=3
EKT_DEADLINE_SECONDS=5
EKT_MAX_RETRIES=2
EKT_RETRY_JITTER_SECONDS=0.1
EKT_MAX_RESPONSE_BYTES=5000000
EKT_ASSET_ALLOWED_HOSTS=ekt.kz

# Fixture cart actions expire after at most 300 seconds.
CART_ACTION_TTL_SECONDS=300
CART_MAX_QUANTITY=10000
# Optional local SQLite path; defaults to backend/db.sqlite3.
SQLITE_PATH=/tmp/ekt-demo.sqlite3

DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-me-outside-development
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# URL of the backend API used by the frontend during local development.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Full catalog index synchronization.
CATALOG_INDEX_PATH=var/catalog_index.json
CATALOG_SYNC_STATUS_PATH=var/catalog_sync_status.json
CATALOG_SYNC_MAX_PAGES=1000
CATALOG_SYNC_PER_PAGE=100
CATALOG_SYNC_INTERVAL_HOURS=24
CATALOG_SEARCH_MAX_RESULTS=5
